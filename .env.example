# Copy to .env and fill in. Never commit .env.

# Required
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Shared secret clients send when opening the WebSocket (openssl rand -hex 32).
# The server refuses to start without it.
BOT_AUTH_TOKEN=
PORT=8080

# Optional: GitHub tool (propose-then-confirm writes)
GITHUB_PAT=

# Optional: Gmail (read-only) and Google Calendar. See docs/SETUP.md, then run
# scripts/google-oauth-setup.js to obtain the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional: route deep_thoughtful turns through a Claude subscription instead of the API
# DEEP_THOUGHTFUL_PROVIDER=claude-code
# CLAUDE_CODE_OAUTH_TOKEN=
# ALLOW_CLAUDE_CODE_API_FALLBACK=
# CLAUDE_BIN=claude

# Optional tuning
# TASK_RETENTION_DAYS=
# WORKER_TIMEOUT_MS=
# WORKER_MAX_TURNS=
# WORKER_CONCURRENCY=
# WORKER_ALLOWED_TOOLS=
# MAX_TASKS_PER_RUN=
# RATE_LIMIT_UTILIZATION_SCALE=
